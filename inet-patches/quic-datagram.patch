+//
+// SPDX-License-Identifier: LGPL-3.0-or-later
+//
+
+#include "QuicDatagramReceiver.h"
+#include "inet/networklayer/common/L3AddressResolver.h"
+#include "inet/applications/base/ApplicationPacket_m.h"
+
+namespace inet {
+
+Define_Module(QuicDatagramReceiver);
+
+QuicDatagramReceiver::~QuicDatagramReceiver()
+{
+    for (QuicSocket *clientSocket : clientSockets)
+        delete clientSocket;
+}
+
+void QuicDatagramReceiver::handleStartOperation(LifecycleOperation *operation)
+{
+    L3Address localAddress = L3AddressResolver().resolve(par("localAddress"));
+    int localPort = par("localPort");
+
+    listeningSocket.setOutputGate(gate("socketOut"));
+    listeningSocket.bind(localAddress, localPort);
+    listeningSocket.listen();
+    listeningSocket.setCallback(this);
+    EV_INFO << "QuicDatagramReceiver: listening on port " << localPort << endl;
+}
+
+void QuicDatagramReceiver::handleStopOperation(LifecycleOperation *operation)
+{
+    listeningSocket.close();
+    for (QuicSocket *clientSocket : clientSockets)
+        clientSocket->close();
+}
+
+void QuicDatagramReceiver::handleCrashOperation(LifecycleOperation *operation) { }
+
+void QuicDatagramReceiver::handleMessageWhenUp(cMessage *msg)
+{
+    if (msg->isSelfMessage())
+        return;
+    if (listeningSocket.belongsToSocket(msg)) {
+        listeningSocket.processMessage(msg);
+    }
+    else {
+        for (QuicSocket *clientSocket : clientSockets) {
+            if (clientSocket->belongsToSocket(msg)) {
+                clientSocket->processMessage(msg);
+                break;
+            }
+        }
+    }
+}
+
+void QuicDatagramReceiver::socketConnectionAvailable(QuicSocket *socket)
+{
+    QuicSocket *clientSocket = socket->accept();
+    clientSocket->setCallback(this);
+    clientSockets.push_back(clientSocket);
+    EV_INFO << "QuicDatagramReceiver: accepted connection, socket " << clientSocket->getSocketId() << endl;
+}
+
+void QuicDatagramReceiver::socketDatagramArrived(QuicSocket* socket, Packet *packet)
+{
+    auto payload = packet->peekAtFront<ApplicationPacket>();
+    long seq = payload->getSequenceNumber();
+    numReceived++;
+    EV_INFO << "QuicDatagramReceiver: RECEIVED datagram seq=" << seq
+            << "  (prev=" << lastSeq << ")" << (seq > lastSeq + 1 ? "  <-- GAP (perdita)" : "") << endl;
+    lastSeq = seq;
+    delete packet;
+}
+
+void QuicDatagramReceiver::socketDestroyed(QuicSocket *socket)
+{
+    if (socket != &listeningSocket) {
+        for (auto it = clientSockets.begin(); it != clientSockets.end(); ++it) {
+            if (*it == socket) { clientSockets.erase(it); break; }
+        }
+        delete socket;
+    }
+}
+
+void QuicDatagramReceiver::finish()
+{
+    EV_INFO << "QuicDatagramReceiver: TOTAL datagrams received = " << numReceived << endl;
+    recordScalar("datagramsReceived", numReceived);
+}
+
+} //namespace
