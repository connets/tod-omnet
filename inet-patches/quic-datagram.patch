+//
+// RFC 9221 DATAGRAM frame.
+//
+// Trasporta un singolo datagramma applicativo inaffidabile e non ordinato:
+// niente stream, niente offset. Il payload (es. SensorDataResponse) e' salvato
+// direttamente come data del frame (a differenza di QuicStreamFrame, che li
+// recupera lazy dallo Stream).
+//
+// E' ack-eliciting e conta in-flight (default di QuicFrame::setHeader per i tipi
+// non-ACK/CC/PADDING), quindi partecipa a RTT e congestion control. MA non viene
+// mai RITRASMESSO: NON sovrascriviamo onFrameLost(), quindi resta il no-op della
+// classe base QuicFrame::onFrameLost(). Questa e' esattamente la semantica RFC 9221.
+//
+class QuicDatagramFrame: public QuicFrame {
+public:
+    QuicDatagramFrame();
+    QuicDatagramFrame(Ptr<const DatagramFrameHeader> header, Ptr<const Chunk> data);
+    virtual ~QuicDatagramFrame();
+
+    virtual void setHeader(Ptr<const FrameHeader> header) override;
+    virtual bool hasData() override { return true; }
+    virtual bool equals(const QuicFrame *other) override;
+
+    virtual Ptr<const DatagramFrameHeader> getDatagramHeader() {
+        return datagramHeader;
+    }
+
+    // NB: nessun override di onFrameLost()/onFrameAcked(): un datagramma perso
+    // NON viene ri-accodato -> nessuna ritrasmissione (a differenza dello stream).
+
+private:
+    Ptr<const DatagramFrameHeader> datagramHeader = nullptr;
