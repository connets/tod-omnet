+void Connection::newDatagram(Ptr<const Chunk> data)
+{
+    // RFC 9221: costruisce un DATAGRAM frame con il payload applicativo e lo accoda.
+    // Non passa da uno Stream: nessun offset, nessun ordinamento, nessuna ritrasmissione.
+
+    // RFC 9221: se il peer non ha annunciato max_datagram_frame_size (=0) non si inviano datagram.
+    uint64_t peerMax = remoteTransportParameters->maxDatagramFrameSize;
+    if (peerMax == 0) {
+        EV_WARN << "Connection::newDatagram: peer does not support DATAGRAM frames "
+                   "(max_datagram_frame_size=0), dropping" << endl;
+        return;
+    }
+
+    auto header = makeShared<DatagramFrameHeader>();
+    header->setLength(B(data->getChunkLength()).get());
+    header->calcChunkLength();
+
+    auto frame = new QuicDatagramFrame(header, data);
+
+    // RFC 9221: non inviare un DATAGRAM frame piu' grande del max_datagram_frame_size del peer.
+    if ((uint64_t) frame->getSize() > peerMax) {
+        EV_WARN << "Connection::newDatagram: frame size " << frame->getSize()
+                << " > peer max_datagram_frame_size " << peerMax << ", dropping" << endl;
+        delete frame;
+        return;
+    }
+
+    datagramQueue.push_back(frame);
+    sendPackets();
+}
+
+void Connection::processReceivedDatagram(Ptr<const Chunk> data)
+{
+    // RFC 9221: consegna immediata all'app, senza reassembly ne' ordinamento.
+    appSocket->sendDatagram(data);
+}
