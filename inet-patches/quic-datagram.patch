+//
+// SPDX-License-Identifier: LGPL-3.0-or-later
+//
+
+#include "QuicDatagramSender.h"
+#include "inet/networklayer/common/L3AddressResolver.h"
+#include "inet/applications/base/ApplicationPacket_m.h"
+
+namespace inet {
+
+Define_Module(QuicDatagramSender);
+
+QuicDatagramSender::~QuicDatagramSender()
+{
+    cancelAndDelete(sendTimer);
+}
+
+void QuicDatagramSender::handleStartOperation(LifecycleOperation *operation)
+{
+    numDatagrams = par("numDatagrams");
+    datagramBytes = par("datagramBytes");
+    sendInterval = par("sendInterval");
+
+    L3Address localAddress = L3AddressResolver().resolve(par("localAddress"));
+    int localPort = par("localPort");
+    L3Address connectAddress = L3AddressResolver().resolve(par("connectAddress"));
+    int connectPort = par("connectPort");
+
+    socket.setOutputGate(gate("socketOut"));
+    socket.bind(localAddress, localPort);
+    socket.connect(connectAddress, connectPort);
+    socket.setCallback(this);
+
+    sendTimer = new cMessage("sendTimer");
+    EV_INFO << "QuicDatagramSender: connecting to " << connectAddress << ":" << connectPort << endl;
+}
+
+void QuicDatagramSender::handleStopOperation(LifecycleOperation *operation)
+{
+    socket.close();
+}
+
+void QuicDatagramSender::handleCrashOperation(LifecycleOperation *operation) { }
+
+void QuicDatagramSender::handleMessageWhenUp(cMessage *msg)
+{
+    if (msg->isSelfMessage()) {
+        if (msg == sendTimer)
+            sendOneDatagram();
+    }
+    else
+        socket.processMessage(msg);
+}
+
+void QuicDatagramSender::socketEstablished(QuicSocket *s)
+{
+    EV_INFO << "QuicDatagramSender: connection established, sending " << numDatagrams
+            << " datagrams every " << sendInterval << endl;
+    seq = 0;
+    scheduleAfter(SimTime::ZERO, sendTimer);   // primo invio subito dopo l'handshake
+}
+
+void QuicDatagramSender::sendOneDatagram()
+{
+    Packet *packet = new Packet("datagram");
+    auto payload = makeShared<ApplicationPacket>();
+    payload->setChunkLength(B(datagramBytes));
+    payload->setSequenceNumber(seq);
+    packet->insertAtBack(payload);
+
+    EV_INFO << "QuicDatagramSender: sendDatagram seq=" << seq << " (" << datagramBytes << "B)" << endl;
+    socket.sendDatagram(packet);
+    numSent++;
+    seq++;
+
+    if (seq < numDatagrams)
+        scheduleAfter(sendInterval, sendTimer);
+}
+
+void QuicDatagramSender::finish()
+{
+    EV_INFO << "QuicDatagramSender: TOTAL datagrams sent = " << numSent << endl;
+    recordScalar("datagramsSent", numSent);
+}
+
+} //namespace
