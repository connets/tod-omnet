+QuicPacket *PacketBuilder::addFramesFromDatagramQueue(QuicPacket *packet, int maxPacketSize)
+{
+    if (datagramQueue == nullptr)
+        return packet;
+
+    // capacita' di un pacchetto vuoto (senza header dei frame gia' presenti)
+    int emptyCapacity = maxPacketSize - (int) getPacketSize(nullptr);
+
+    while (!datagramQueue->empty()) {
+        auto datagramFrame = datagramQueue->front();
+        int datagramFrameSize = (int) datagramFrame->getSize();   // header + payload
+
+        // RFC 9221: un DATAGRAM frame non e' frammentabile. Se non entra nemmeno in un
+        // pacchetto vuoto va SCARTATO (l'app deve dimensionarlo <= max_datagram_frame_size).
+        if (datagramFrameSize > emptyCapacity) {
+            EV_WARN << "PacketBuilder: datagram too large (" << datagramFrameSize
+                    << " > " << emptyCapacity << "), dropped" << endl;
+            delete datagramFrame;
+            datagramQueue->erase(datagramQueue->begin());
+            continue;
+        }
+        // Non entra nel pacchetto corrente (gia' parzialmente pieno): lo mandiamo nel prossimo.
+        if ((maxPacketSize - (int) getPacketSize(packet)) < datagramFrameSize) {
+            return packet;
+        }
+        EV_DEBUG << "PacketBuilder: insert datagram frame, size=" << datagramFrameSize << endl;
+        packet = addFrameToPacket(packet, datagramFrame);
+        datagramQueue->erase(datagramQueue->begin());
+    }
+    return packet;
+}
