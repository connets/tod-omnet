+[General]
+network = inet.examples.quic.datagram_test.DatagramTest
+sim-time-limit = 5s
+
+cmdenv-express-mode = false
+**.cmdenv-log-level = info
+
+# QUIC concreto
+**.quic.typename = "Quic"
+# niente limiti di flow control per lo stream 0 (handshake/controllo)
+**.quic.initialMaxData = 100MB
+**.quic.initialMaxStreamData = 100MB
+# RFC 9221: supporto DATAGRAM annunciato da entrambi i lati
+**.quic.maxDatagramFrameSize = 1200B
+**.quic.numReceivedAckElicitingsBeforeAck = 1
+
+**.ppp[*].queue.packetCapacity = 1000
+**.ppp[*].ppp.mtu = 1280B
+
+# ---- SENDER: invia 20 datagrammi inaffidabili numerati ----
+**.sender.hasQuic = true
+**.sender.numApps = 1
+**.sender.app[0].typename = "QuicDatagramSender"
+**.sender.app[0].connectAddress = "receiver"
+**.sender.app[0].connectPort = 1000
+**.sender.app[0].localPort = 1001
+**.sender.app[0].numDatagrams = 20
+**.sender.app[0].datagramBytes = 800B
+**.sender.app[0].sendInterval = 5ms
+
+# ---- RECEIVER ----
+**.receiver.hasQuic = true
+**.receiver.numApps = 1
+**.receiver.app[0].typename = "QuicDatagramReceiver"
+**.receiver.app[0].localPort = 1000
+
+# ---- 20% di perdita pacchetti sul link router1->router2 (direzione sender->receiver) ----
+# Colpisce i datagrammi in andata; gli ACK (ritorno) passano su gate diversi -> non persi.
+**.router1.pppg$o[1].channel.per = 0.2
