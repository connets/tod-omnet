+//
+// SPDX-License-Identifier: LGPL-3.0-or-later
+//
+// Rete di test per i DATAGRAM QUIC (RFC 9221): sender -> router1 -=lossy=- router2 -> receiver.
+// La perdita e' applicata sul link router1<->router2 (PeriodicLossChannel, parametro per).
+//
+
+package inet.examples.quic.datagram_test;
+
+import inet.networklayer.configurator.ipv4.Ipv4NetworkConfigurator;
+import inet.node.inet.Router;
+import inet.node.inet.StandardHost;
+import inet.common.misc.PeriodicLossChannel;
+
+network DatagramTest
+{
+    parameters:
+        double linkDelay @unit(s) = default(5ms);
+        double linkDatarate @unit(bps) = default(100Mbps);
+
+    types:
+        channel link extends PeriodicLossChannel
+        {
+            datarate = parent.linkDatarate;
+            delay = parent.linkDelay;
+            per = default(0);
+        }
+        channel idealLink extends ned.DatarateChannel
+        {
+            datarate = 1000Mbps;
+            delay = 1ms;
+            per = 0;
+        }
+    submodules:
+        configurator: Ipv4NetworkConfigurator { @display("p=222,32"); }
+        sender: StandardHost { @display("p=57,137"); }
+        router1: Router { @display("p=146,137"); }
+        router2: Router { @display("p=305,137"); }
+        receiver: StandardHost { @display("p=390,137"); }
+
+    connections:
+        sender.pppg++ <--> idealLink <--> router1.pppg++;
+        router1.pppg++ <--> link <--> router2.pppg++;
+        router2.pppg++ <--> idealLink <--> receiver.pppg++;
+}
